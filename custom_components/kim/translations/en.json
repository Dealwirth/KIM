{
  "config": {
    "step": {
      "user": {
        "title": "Set up KIM AI Manager",
        "description": "Configure the agent engine. 'auto' (default) chains Cloud -> Local -> Mock so KIM keeps working for free even when the cloud quota runs out.",
        "data": {
          "backend": "Backend",
          "api_key": "OpenHands API key",
          "base_url": "OpenHands Cloud URL",
          "local_url": "Local agent server (optional)",
          "model": "Model",
          "max_parallel": "Max parallel agents",
          "archive_repo": "Archive repository (optional, e.g. user/kim-archive)"
        }
      }
    },
    "error": {
      "api_key_required": "The cloud backend requires an API key.",
      "invalid_auth": "The API key was rejected.",
      "cannot_connect": "Could not reach OpenHands."
    },
    "abort": {
      "already_configured": "KIM is already configured."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "KIM options",
        "data": {
          "backend": "Backend",
          "api_key": "OpenHands API key",
          "base_url": "OpenHands Cloud URL",
          "local_url": "Local agent server (optional)",
          "model": "Model",
          "max_parallel": "Max parallel agents",
          "archive_repo": "Archive repository (optional, e.g. user/kim-archive)"
        }
      }
    }
  },
  "services": {
    "submit": {
      "name": "Submit task",
      "description": "Splits a goal into subtasks and dispatches them to the agents.",
      "fields": {
        "goal": {
          "name": "Goal",
          "description": "What the agents should do."
        },
        "title": {
          "name": "Title",
          "description": "Optional plan name."
        },
        "plan": {
          "name": "Plan (JSON)",
          "description": "Optional pre-built plan as JSON."
        }
      }
    },
    "cancel": {
      "name": "Cancel task",
      "fields": {
        "task_id": {
          "name": "Task ID"
        }
      }
    },
    "retry": {
      "name": "Retry task",
      "fields": {
        "task_id": {
          "name": "Task ID"
        }
      }
    },
    "pause": {
      "name": "Pause",
      "description": "Stops assigning new tasks."
    },
    "resume": {
      "name": "Resume",
      "description": "Resumes assigning tasks."
    },
    "note": {
      "name": "Write note",
      "description": "Adds a message to the shared scratchpad.",
      "fields": {
        "text": {
          "name": "Text"
        },
        "author": {
          "name": "Author"
        },
        "task_id": {
          "name": "Task ID (optional)"
        }
      }
    },
    "fetch_file": {
      "name": "Fetch file from agent",
      "description": "Copies a single file from the agent workspace to /local/kim/.",
      "fields": {
        "task_id": {
          "name": "Task ID"
        },
        "path": {
          "name": "Path"
        },
        "save_as": {
          "name": "Save as"
        }
      }
    },
    "collect_artifacts": {
      "name": "Collect all artifacts",
      "description": "Downloads the whole agent workspace as a ZIP to /local/kim/.",
      "fields": {
        "task_id": {
          "name": "Task ID"
        }
      }
    },
    "archive": {
      "name": "Archive run",
      "description": "Store the run off-device (GitHub) or in bounded local storage."
    },
    "archive_list": {
      "name": "List archive",
      "description": "List stored runs."
    },
    "archive_load": {
      "name": "Load run",
      "description": "Load a stored run.",
      "fields": {
        "name": {
          "name": "Run name"
        }
      }
    }
  }
}
